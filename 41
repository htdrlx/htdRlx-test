local function _xGBT()
    local _xChr=_xLPl.Character
    if not _xChr or not _xChr:FindFirstChild("HumanoidRootPart") then return nil end
    local _xRt=_xChr.HumanoidRootPart
    local _xBst=nil
    local _xSht=math.huge
    local _xVpc=_xCam.ViewportSize/2
    for _,_xMdl in ipairs(workspace:GetDescendants()) do
        if _xMdl:IsA("Model") and _xMdl~=_xChr then
            local _xHm=_xMdl:FindFirstChildOfClass("Humanoid")
            local _xPt=_xMdl:FindFirstChild(_xCfg.AimPart)
            if _xHm and _xHm.Health>0 and _xPt and not _xMdl:FindFirstChildOfClass("ForceField") then
                if _xCfg.TargetTeam then
                    local _xPl2=_xPlr:GetPlayerFromCharacter(_xMdl)
                    if _xPl2 and _xPl2.Team==_xLPl.Team then continue end
                end
                local _xDs=(_xRt.Position-_xPt.Position).Magnitude
                if _xDs<=_xCfg.MaxDistance then
                    if not _xCfg.IgnoreWalls then
                        local _xRP=RaycastParams.new()
                        _xRP.FilterType=Enum.RaycastFilterType.Exclude
                        _xRP.FilterDescendantsInstances={_xChr,_xMdl}
                        local _xRR=workspace:Raycast(_xCam.CFrame.Position,(_xPt.Position-_xCam.CFrame.Position).Unit*_xDs,_xRP)
                        if _xRR then continue end
                    end
                    local _xSP,_xOn=_xCam:WorldToViewportPoint(_xPt.Position)
                    if _xOn then
                        local _xSD=(Vector2.new(_xSP.X,_xSP.Y)-_xVpc).Magnitude
                        if _xSD<_xSht then
                            _xSht=_xSD
                            _xBst=_xMdl
                        end
                    end
                end
            end
        end
    end
    return _xBst
end

local function _xUUI()
    if _xAim then
        if _xTgt then
            _xUSk.Color=_xChC
            _xLIc.ImageColor3=_xChC
        else
            _xUSk.Color=Color3.fromRGB(255,255,50)
            _xLIc.ImageColor3=Color3.fromRGB(255,255,50)
        end
    else
        _xUSk.Color=Color3.fromRGB(255,255,255)
        _xLIc.ImageColor3=Color3.fromRGB(255,255,255)
        _xTGu.Parent=nil
    end
end

_xRun:BindToRenderStep("_xHrdLck",Enum.RenderPriority.Camera.Value+200,function()
    if not _xAim then
        if _xCTw then _xCTw:Cancel();_xCTw=nil end
        return
    end
    local _xNw=false
    if not _xTgt or not _xTgt.Parent then
        _xNw=true
    else
        local _xH2=_xTgt:FindFirstChildOfClass("Humanoid")
        local _xP2=_xTgt:FindFirstChild(_xCfg.AimPart)
        if not _xH2 or _xH2.Health<=0 or not _xP2 then _xNw=true end
    end
    if _xNw then
        if _xCTw then _xCTw:Cancel();_xCTw=nil end
        _xTgt=_xGBT()
        _xUUI()
    end
    if _xTgt then
        local _xTP=_xTgt:FindFirstChild(_xCfg.AimPart)
        if _xTP then
            if _xTGu.Parent~=_xTP then _xTGu.Parent=_xTP end
            _xCam.CameraType=Enum.CameraType.Scriptable
            local _xTI=TweenInfo.new(0.08,Enum.EasingStyle.Linear,Enum.EasingDirection.Out)
            local _xGl={CFrame=CFrame.lookAt(_xCam.CFrame.Position,_xTP.Position)}
            if _xCTw then _xCTw:Cancel() end
            _xCTw=_xTwS:Create(_xCam,_xTI,_xGl)
            _xCTw:Play()
        end
    end
end)

local function _xTAl()
    _xAim=not _xAim
    if not _xAim then
        _xTgt=nil
        if _xCTw then _xCTw:Cancel();_xCTw=nil end
        _xCam.CameraType=Enum.CameraType.Custom
    end
    _xUUI()
end

