-- // ESP System
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "BallESP"
ESPFolder.Parent = workspace

local function AddBallESP(ball)
    if ESPFolder:FindFirstChild(ball.Name.."_hl") then return end
    local hl = Instance.new("SelectionBox")
    hl.Name = ball.Name.."_hl"
    hl.Adornee = ball
    hl.Color3 = Color3.fromRGB(255, 50, 50)
    hl.LineThickness = 0.05
    hl.SurfaceTransparency = 0.7
    hl.SurfaceColor3 = Color3.fromRGB(255, 100, 100)
    hl.Parent = ESPFolder

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 60, 0, 25)
    bb.AlwaysOnTop = true
    bb.Adornee = ball
    bb.Parent = ESPFolder

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,1,0)
    lbl.BackgroundTransparency = 1
    lbl.Text = "🔴 BALL"
    lbl.TextColor3 = Color3.fromRGB(255,50,50)
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamBold
    lbl.Parent = bb
end

-- // Main Loop
local lastSkillTime = 0

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local ballNearby = false

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Ball" or obj.Name == "KillerBall" or obj.Name:lower():find("ball")) then

            if Settings.ESP then AddBallESP(obj) end

            local dist = (obj.Position - hrp.Position).Magnitude

            if dist <= Settings.TriggerRange then ballNearby = true end

            -- Auto Parry
            if Settings.AutoParry and dist <= Settings.ParryRange then
                for _, remote in ipairs(game:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        local n = remote.Name:lower()
                        if n:find("parry") or n:find("block") then
                            pcall(function() remote:FireServer() end)
                        end
                    end
                end
            end

            -- Ball Redirect
            if Settings.BallRedirect then
                local bv = obj:FindFirstChild("BodyVelocity")
                if bv then
                    local dir = (hrp.Position - obj.Position).Unit
                    bv.Velocity = -dir * bv.Velocity.Magnitude
                end
            end

            -- Explosion FX
            if Settings.ExplosionEffect and dist <= 8 then
                local exp = Instance.new("Explosion")
                exp.Position = obj.Position
                exp.BlastRadius = 0
                exp.BlastPressure = 0
                exp.ExplosionType = Enum.ExplosionType.NoCraters
                exp.Parent = workspace
            end
        end
    end

    -- Auto Skill
    if Settings.AutoSkill then
        local now = tick()
        if now - lastSkillTime >= Settings.SkillDelay then
            lastSkillTime = now
            for _, remote in ipairs(game:GetDescendants()) do
                if remote:IsA("RemoteEvent") then
                    local n = remote.Name:lower()
                    if n:find("skill") or n:find("ability") then
                        pcall(function() remote:FireServer() end)
                    end
                end
            end
        end
    end

    -- Spam modes
    if Settings.AutoSpam then DoSpam() end
    if Settings.TriggerSpam and ballNearby then DoSpam() end
    if spamHolding then DoSpam() end
end)

