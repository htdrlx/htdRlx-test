-- // Spam helper
local lastSpam = 0
local function DoSpam()
    local now = tick()
    if now - lastSpam < Settings.SpamDelay then return end
    lastSpam = now
    for _, remote in ipairs(game:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local n = remote.Name:lower()
            if n:find("parry") or n:find("block") or n:find("skill") or n:find("ability") then
                pcall(function() remote:FireServer() end)
            end
        end
    end
end

